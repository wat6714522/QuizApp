### Create invitation (valid, mixed-case email) -> 201
# @no-cookie-jar
POST {{host}}/api/authentication/invitations
Cookie: qd_session={{instructorToken}}
Content-Type: application/json

{ "email": "Instructor2.{{$uuid}}@QuizDeck.test" }

> {%
  client.test("201, lowercase email, 64-hex token", () => {
    client.assert(response.status === 201, `got ${response.status}`);
    const email = response.body.invitation.email;
    client.assert(email === email.toLowerCase(), `invitation stored ${email}`);
    client.assert(/^[a-f0-9]{64}$/.test(response.body.token), "bad token");
    client.global.set("inviteEmail", email);
    client.global.set("inviteToken", response.body.token);
  });
%}

### Look up invitation by token -> 200
# @no-cookie-jar
GET {{host}}/api/authentication/invitation?token={{inviteToken}}

> {%
  client.test("200 with the invited email", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    client.assert(response.body.invitation.email === client.global.get("inviteEmail"), "wrong email");
  });
%}

