### Register instructor with a different email -> 400 EMAIL_MISMATCH
# @no-cookie-jar
POST {{host}}/api/authentication/register-instructor
Content-Type: application/json

{ "name": "Wrong Email", "email": "someone-else-{{$uuid}}@quizdeck.test", "password": "{{password}}", "token": "{{inviteToken}}" }

> {%
  client.test("400 EMAIL_MISMATCH", () => {
    client.assert(response.status === 400, `got ${response.status}`);
    client.assert(response.body.error?.code === "EMAIL_MISMATCH", `code ${JSON.stringify(response.body.error?.code)}`);
  });
%}

### Register instructor with the invitation -> 201
# @no-cookie-jar
POST {{host}}/api/authentication/register-instructor
Content-Type: application/json

{ "name": "Other Instructor", "email": "{{inviteEmail}}", "password": "{{password}}", "token": "{{inviteToken}}" }

> {%
  client.test("201, instructor, session cookie", () => {
    client.assert(response.status === 201, `got ${response.status}`);
    client.assert(response.body.user.role === "instructor", `role ${response.body.user.role}`);
    const sc = response.headers.valueOf("Set-Cookie") ?? "";
    client.assert(/qd_session=/.test(sc), "no session cookie");
    client.global.set("otherInstructorToken", /qd_session=([^;]+)/.exec(sc)[1]);
    client.global.set("otherInstructorId", response.body.user.id);
  });
%}

### Reuse the invitation -> 410
# @no-cookie-jar
POST {{host}}/api/authentication/register-instructor
Content-Type: application/json

{ "name": "Again", "email": "{{inviteEmail}}", "password": "{{password}}", "token": "{{inviteToken}}" }

> {%
  client.test("410 INVITATION_USED", () => {
    client.assert(response.status === 410, `got ${response.status}`);
    client.assert(response.body.error?.code === "INVITATION_USED", `code ${JSON.stringify(response.body.error?.code)}`);
  });
%}

### Look up the used invitation -> 410
# @no-cookie-jar
GET {{host}}/api/authentication/invitation?token={{inviteToken}}

> {% client.test("410", () => client.assert(response.status === 410, `got ${response.status}`)); %}

### Invited instructor cannot invite others
# @no-cookie-jar
GET {{host}}/api/me
Cookie: qd_session={{otherInstructorToken}}

> {%
  client.test("instructor without invite permission", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    client.assert(response.body.user.role === "instructor", "not an instructor");
    client.assert(response.body.user.canInviteInstructors === false, "should not be able to invite");
  });
%}

### Logout clears the cookie
# @no-cookie-jar
POST {{host}}/api/authentication/logout
Cookie: qd_session={{studentToken}}

> {%
  client.test("200 and cookie expired", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const sc = response.headers.valueOf("Set-Cookie") ?? "";
    client.assert(/qd_session=/.test(sc) && /(Max-Age=0|Expires=Thu, 01 Jan 1970)/i.test(sc), `not cleared: ${sc}`);
  });
%}

### Logout without a session still works
# @no-cookie-jar
POST {{host}}/api/authentication/logout

> {% client.test("200", () => client.assert(response.status === 200, `got ${response.status}`)); %}
