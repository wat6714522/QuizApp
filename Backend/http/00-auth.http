### Register ignores a client-supplied role
# @no-cookie-jar
POST {{host}}/api/authentication/register
Content-Type: application/json

{ "name": "Sneaky", "email": "sneaky-{{$uuid}}@quizdeck.test", "password": "{{password}}", "role": "instructor" }

> {%
  client.test("201 and role forced to student (or role rejected with 400)", () => {
    if (response.status === 400) return;
    client.assert(response.status === 201, `got ${response.status}`);
    client.assert(response.body.user.role === "student", `role was ${response.body.user.role}`);
  });
%}

### Register with a mixed-case email -> stored lowercase
# @no-cookie-jar
POST {{host}}/api/authentication/register
Content-Type: application/json

{ "name": "Mixed Case", "email": "Mixed.{{$uuid}}@QuizDeck.TEST", "password": "{{password}}" }

> {%
  client.test("201 and email lowercased", () => {
    client.assert(response.status === 201, `got ${response.status}`);
    const email = response.body.user.email;
    client.assert(email === email.toLowerCase(), `stored as ${email}`);
    client.global.set("mixedEmail", email);
    client.global.set("mixedEmailUpper", email.toUpperCase());
  });
%}

### Login with the upper-case version of that email -> 200
# @no-cookie-jar
POST {{host}}/api/authentication/login
Content-Type: application/json

{ "email": "{{mixedEmailUpper}}", "password": "{{password}}" }

> {%
  client.test("200 — login is case-insensitive", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    client.assert(response.body.user.email === client.global.get("mixedEmail"), "different account");
  });
%}

### Register the same email in different case -> 409
# @no-cookie-jar
POST {{host}}/api/authentication/register
Content-Type: application/json

{ "name": "Case Dup", "email": "{{mixedEmailUpper}}", "password": "{{password}}" }

> {% client.test("409", () => client.assert(response.status === 409, `got ${response.status}`)); %}

### Register duplicate email -> 409
# @no-cookie-jar
POST {{host}}/api/authentication/register
Content-Type: application/json

{ "name": "Dup", "email": "{{studentEmail}}", "password": "{{password}}" }

> {%
  client.test("409 with error envelope", () => {
    client.assert(response.status === 409, `got ${response.status} — is the unique index on users.email created?`);
    client.assert(response.body.error?.code, "missing error.code");
  });
%}

