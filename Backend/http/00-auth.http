# Run order: 00-auth -> 01-course -> 02-quiz -> 03-question -> 04-attempt -> 05-cors -> 06-cleanup
# Each file saves ids/tokens with client.global for the next one.
#
# One-time setup: run this file once, then promote the instructor and let them invite:
#   db.users.updateOne({ email: "instructor@quizdeck.test" },
#     { $set: { role: "instructor", canInviteInstructors: true }, $inc: { tokenVersion: 1 } })

### Register instructor (promote once by hand — see top of file)
# @no-cookie-jar
POST {{host}}/api/authentication/register
Content-Type: application/json

{ "name": "Test Instructor", "email": "{{instructorEmail}}", "password": "{{password}}" }

> {%
  client.test("201 new or 409 already registered", () => {
    client.assert([201, 409].includes(response.status), `got ${response.status}`);
  });
  if (response.status === 201) client.test("no password in response", () => {
    client.assert(!JSON.stringify(response.body).includes("password"), "leaks password hash");
  });
%}

