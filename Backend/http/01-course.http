Content-Type: application/json

{ "code": "CSX4107", "name": "Web" }

> {% client.test("400", () => client.assert(response.status === 400, `got ${response.status}`)); %}

### Create course (valid) -> 201, code trimmed + uppercased
# @no-cookie-jar
POST {{host}}/api/course
Cookie: qd_session={{instructorToken}}
Content-Type: application/json

{ "code": "  http{{$timestamp}} ", "name": "HTTP Test Course" }

> {%
  client.test("201, normalized code, owned by caller, empty roster", () => {
    client.assert(response.status === 201, `got ${response.status}`);
    const c = response.body;
    client.assert(/^HTTP\d+$/.test(c.code), `code was "${c.code}"`);
    client.assert(c.ownerId === client.global.get("instructorId"), "ownerId is not the caller");
    client.assert(c.studentCount === 0 && Array.isArray(c.students) && c.students.length === 0, JSON.stringify(c));
    client.assert(c.studentIds === undefined, "raw studentIds leaked");
    client.global.set("courseId", c.id);
    client.global.set("courseCode", c.code);
    client.global.set("courseCodeLower", c.code.toLowerCase());
  });
%}

### Same code in a different case -> 409
# @no-cookie-jar
POST {{host}}/api/course
Cookie: qd_session={{instructorToken}}
Content-Type: application/json

{ "code": "{{courseCodeLower}}", "name": "Duplicate code course" }

> {% client.test("409", () => client.assert(response.status === 409, `got ${response.status}`)); %}

### Another instructor can use the same code -> 201
# @no-cookie-jar
POST {{host}}/api/course
Cookie: qd_session={{otherInstructorToken}}
Content-Type: application/json

{ "code": "{{courseCode}}", "name": "Other instructor's section" }

> {%
  client.test("201", () => {
    client.assert(response.status === 201, `got ${response.status}`);
    client.global.set("otherCourseId", response.body.id);
  });
%}

### Create a throwaway course
# @no-cookie-jar
POST {{host}}/api/course
Cookie: qd_session={{instructorToken}}
Content-Type: application/json

{ "code": "TMP{{$timestamp}}", "name": "Throwaway test course" }

> {%
  client.test("201", () => {
    client.assert(response.status === 201, `got ${response.status}`);
    client.global.set("tmpCourseId", response.body.id);
  });
%}

### Delete someone else's course -> 403
# @no-cookie-jar
DELETE {{host}}/api/course/{{tmpCourseId}}
Cookie: qd_session={{otherInstructorToken}}

> {% client.test("403", () => client.assert(response.status === 403, `got ${response.status}`)); %}

