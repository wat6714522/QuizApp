### One unknown email -> 404 naming it, and nobody is added
# @no-cookie-jar
POST {{host}}/api/course/{{courseId}}/student
Cookie: qd_session={{instructorToken}}
Content-Type: application/json

{ "students": ["{{studentEmail}}", "ghost-{{$uuid}}@quizdeck.test"] }

> {%
  client.test("404 and the message names the missing email", () => {
    client.assert(response.status === 404, `got ${response.status}`);
    client.assert(/ghost-/.test(response.body.error?.message ?? ""), response.body.error?.message);
  });
%}

### The failed add changed nothing
# @no-cookie-jar
GET {{host}}/api/course/{{courseId}}
Cookie: qd_session={{instructorToken}}

> {%
  client.test("roster still empty", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    client.assert(response.body.students.length === 0, "student was added despite the error");
  });
%}

### An instructor's email is rejected -> 404
# @no-cookie-jar
POST {{host}}/api/course/{{courseId}}/student
Cookie: qd_session={{instructorToken}}
Content-Type: application/json

{ "students": ["{{instructorEmail}}"] }

> {% client.test("404", () => client.assert(response.status === 404, `got ${response.status}`)); %}

### Add student using an upper-case email -> 200, stored by id
# @no-cookie-jar
POST {{host}}/api/course/{{courseId}}/student
Cookie: qd_session={{instructorToken}}
Content-Type: application/json

{ "students": ["{{studentEmailUpper}}"] }

> {%
  client.test("200 and roster has { id, name, email } for the student", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const s = response.body.students.find((x) => x.id === client.global.get("studentId"));
    client.assert(s, "student not in roster");
    client.assert(s.email === request.environment.get("studentEmail") && s.name, JSON.stringify(s));
  });
%}

### Adding the same student again doesn't duplicate
# @no-cookie-jar
POST {{host}}/api/course/{{courseId}}/student
Cookie: qd_session={{instructorToken}}
Content-Type: application/json

{ "students": ["{{studentEmail}}", "{{studentEmail}}"] }

> {%
  client.test("200 and still one entry", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const count = response.body.students.filter((x) => x.id === client.global.get("studentId")).length;
    client.assert(count === 1, `student listed ${count} times`);
  });
%}

### Enrolled student sees the course in their list
# @no-cookie-jar
GET {{host}}/api/course
Cookie: qd_session={{studentToken}}

> {%
  client.test("course listed", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    client.assert(response.body.some((c) => c.id === client.global.get("courseId")), "course missing");
  });
%}

### Enrolled student can read the course, without the roster
# @no-cookie-jar
GET {{host}}/api/course/{{courseId}}
Cookie: qd_session={{studentToken}}

> {%
  client.test("200, no students list", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    client.assert(response.body.students === undefined, "roster leaked to a student");
    client.assert(response.body.studentCount >= 1, "studentCount missing");
  });
%}

