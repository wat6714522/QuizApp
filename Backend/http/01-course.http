# @no-cookie-jar
DELETE {{host}}/api/course/{{tmpCourseId}}
Cookie: qd_session={{instructorToken}}

> {% client.test("204", () => client.assert(response.status === 204, `got ${response.status}`)); %}

### Deleted course is gone -> 404
# @no-cookie-jar
GET {{host}}/api/course/{{tmpCourseId}}
Cookie: qd_session={{instructorToken}}

> {% client.test("404", () => client.assert(response.status === 404, `got ${response.status}`)); %}

### List courses as instructor -> own courses only, no roster in the list
# @no-cookie-jar
GET {{host}}/api/course
Cookie: qd_session={{instructorToken}}

> {%
  client.test("200, contains own course, not the other instructor's", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const ids = response.body.map((c) => c.id);
    client.assert(ids.includes(client.global.get("courseId")), "own course missing");
    client.assert(!ids.includes(client.global.get("otherCourseId")), "other instructor's course leaked");
    client.assert(response.body.every((c) => c.students === undefined), "roster should not be in the list");
  });
%}

### List courses as student (not enrolled yet) -> course not listed
# @no-cookie-jar
GET {{host}}/api/course
Cookie: qd_session={{studentToken}}

> {%
  client.test("200 and course not visible", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    client.assert(!response.body.some((c) => c.id === client.global.get("courseId")), "course leaked");
  });
%}

### Get course as owner -> empty roster
# @no-cookie-jar
GET {{host}}/api/course/{{courseId}}
Cookie: qd_session={{instructorToken}}

> {%
  client.test("200 with students []", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    client.assert(Array.isArray(response.body.students) && response.body.students.length === 0, "roster not empty");
  });
%}

