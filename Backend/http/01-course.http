### Remove the outsider as owner -> 200
# @no-cookie-jar
DELETE {{host}}/api/course/{{courseId}}/student/{{outsiderId}}
Cookie: qd_session={{instructorToken}}

> {%
  client.test("200, outsider gone, student kept", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const ids = response.body.students.map((x) => x.id);
    client.assert(!ids.includes(client.global.get("outsiderId")), "outsider still enrolled");
    client.assert(ids.includes(client.global.get("studentId")), "student was removed too");
  });
%}

### Removing again is harmless -> 200
# @no-cookie-jar
DELETE {{host}}/api/course/{{courseId}}/student/{{outsiderId}}
Cookie: qd_session={{instructorToken}}

> {% client.test("200", () => client.assert(response.status === 200, `got ${response.status}`)); %}

### Outsider no longer sees the course
# @no-cookie-jar
GET {{host}}/api/course
Cookie: qd_session={{outsiderToken}}

> {%
  client.test("course not listed", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    client.assert(!response.body.some((c) => c.id === client.global.get("courseId")), "outsider still sees the course");
  });
%}
