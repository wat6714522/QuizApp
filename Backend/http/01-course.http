### Rename course as owner -> 200
# @no-cookie-jar
PUT {{host}}/api/course/{{courseId}}
Cookie: qd_session={{instructorToken}}
Content-Type: application/json

{ "name": "HTTP Test Course (renamed)" }

> {%
  client.test("200, name changed, code kept", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    client.assert(response.body.name === "HTTP Test Course (renamed)", "name not changed");
    client.assert(response.body.code === client.global.get("courseCode"), "code changed");
  });
%}

