# Needs: 00-auth, 01-course, 02-quiz, 03-question (quizId, qMcId, qTfId, qSaId)

### Publish the quiz (has questions now)
# @no-cookie-jar
PUT {{host}}/api/quiz/{{quizId}}
Cookie: qd_session={{instructorToken}}
Content-Type: application/json

{ "status": "published" }

> {%
  client.test("200 published", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    client.assert(response.body.status === "published", "not published");
  });
%}

### Enrolled student sees the published quiz in the list
# @no-cookie-jar
GET {{host}}/api/quiz
Cookie: qd_session={{studentToken}}

> {%
  client.test("quiz listed", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    client.assert(response.body.some((q) => q.id === client.global.get("quizId")), "quiz missing for enrolled student");
  });
%}

### Enrolled student reads quiz for attempt -> no answers, no explanations
# @no-cookie-jar
GET {{host}}/api/quiz/{{quizId}}?for=attempt
Cookie: qd_session={{studentToken}}

> {%
  client.test("200 and nothing leaked", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const qs = response.body.questions;
    client.assert(qs.length === 3, `got ${qs.length}`);
    client.assert(qs.every((q) => q.correctAnswer === undefined), "correctAnswer leaked");
    client.assert(qs.every((q) => q.explanation === undefined), "explanation leaked before grading");
  });
%}

### Enrolled student lists questions -> no answers
# @no-cookie-jar
GET {{host}}/api/question?quizId={{quizId}}
Cookie: qd_session={{studentToken}}

> {%
  client.test("200 and no correctAnswer", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    client.assert(response.body.questions.every((q) => q.correctAnswer === undefined), "correctAnswer leaked");
  });
%}

### Enrolled student reads one question -> no answer
