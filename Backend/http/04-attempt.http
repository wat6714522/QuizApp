### Teacher removes the student from the course mid-attempt
# @no-cookie-jar
DELETE {{host}}/api/course/{{courseId}}/student/{{studentId}}
Cookie: qd_session={{instructorToken}}

> {%
  client.test("200 and student gone", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    client.assert(!response.body.students.some((x) => x.id === client.global.get("studentId")), "still enrolled");
  });
%}

