### Removed student can still submit what was saved -> graded, new answers ignored
# @no-cookie-jar
PUT {{host}}/api/attempt/{{attempt2Id}}
Cookie: qd_session={{studentToken}}
Content-Type: application/json

{ "action": "submit", "answers": [{ "questionId": "{{qMcId}}", "given": "b" }] }

> {%
  client.test("200, graded on the saved (wrong) answer only", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    client.assert(response.body.status === "graded", response.body.status);
    client.assert(response.body.score === 0, `score ${response.body.score} — the late "b" should have been ignored`);
  });
%}

